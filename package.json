{
  "name": "canvas-app",
  "version": "0.0.1",
  "description": "Infinite canvas with advanced 3D capabilities",
  "keywords": [
    "infinite canvas",
    "3D",
    "application",
    "web",
    "encube",
    "take-home exercise"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/phinpho/canvas-app.git"
  },
  "license": "ISC",
  "author": {
    "name": "Rodolfo Pereira",
    "email": "phinpho@users.noreply.github.com",
    "url": "https://phinpho.me/"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "vite build --emptyOutDir",
    "dev": "vite dev",
    "lint": "biome check --error-on-warnings ./",
    "lint:changed": "biome check --changed --no-errors-on-unmatched ./",
    "lint:fix": "biome check --write --error-on-warnings ./",
    "lint:staged": "biome check --staged --no-errors-on-unmatched --error-on-warnings ./",
    "lint:staged:fix": "biome check --write --staged --no-errors-on-unmatched --error-on-warnings ./",
    "prepare": "husky",
    "preview": "vite preview"
  },
  "config": {
    "app": {
      "id": "canvas-app",
      "name": "Canvas App",
      "short_name": "Canvas App",
      "description": "Infinite canvas with advanced 3D capabilities"
    }
  },
  "dependencies": {
    "@babylonjs/core": "^9.30.0",
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "konva": "^10.7.1",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "react-konva-utils": "^2.1.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.10.1",
      "onFail": "download"
    }
  }
}
