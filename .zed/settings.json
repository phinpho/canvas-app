// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
  "languages": {
    "CSS": {
      "code_actions_on_format": {
        "source.action.noDuplicateClasses.biome": true,
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "format_on_save": "modifications_if_available",
      "formatter": { "language_server": { "name": "biome" } }
    },
    "HTML": {
      "code_actions_on_format": {
        "source.action.noDuplicateClasses.biome": true,
        "source.fixAll.biome": true
      },
      "format_on_save": "modifications_if_available",
      "formatter": { "language_server": { "name": "biome" } }
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.action.noDuplicateClasses.biome": true,
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
        "source.suppressRule.inline.biome": false,
        "source.suppressRule.topLevel.biome": false
      },
      "format_on_save": "modifications_if_available",
      "formatter": { "language_server": { "name": "biome" } }
    },
    "JSON": {
      "code_actions_on_format": {
        "source.fixAll.biome": true
      },
      "format_on_save": "modifications_if_available",
      "formatter": { "language_server": { "name": "biome" } }
    },
    "JSONC": {
      "code_actions_on_format": {
        "source.fixAll.biome": true
      },
      "format_on_save": "modifications_if_available",
      "formatter": { "language_server": { "name": "biome" } }
    },
    "TSX": {
      "code_actions_on_format": {
        "source.action.noDuplicateClasses.biome": true,
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
        "source.suppressRule.inline.biome": false,
        "source.suppressRule.topLevel.biome": false
      },
      "format_on_save": "modifications_if_available",
      "formatter": { "language_server": { "name": "biome" } },
      "language_servers": ["typescript-ls", "biome", "!vtsls", "!typescript-language-server"]
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.action.noDuplicateClasses.biome": true,
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
        "source.suppressRule.inline.biome": false,
        "source.suppressRule.topLevel.biome": false
      },
      "format_on_save": "modifications_if_available",
      "formatter": {
        "language_server": { "name": "biome" }
      },
      "language_servers": ["typescript-ls", "biome", "!vtsls", "!typescript-language-server"]
    }
  },
  "lsp": {
    "biome": {
      "settings": {
        "config_path": "./biome.json",
        "require_config_file": true
      }
    }
  }
}
